{
  "name": "jpnov-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "render": "node scripts/render.ts",
    "icons": "node scripts/icons.ts",
    "gen": "npm run render && npm run icons",
    "predev": "npm run gen",
    "dev": "astro dev",
    "prebuild": "npm run gen",
    "build": "astro build",
    "preview": "astro preview",
    "precheck": "npm run gen",
    "check": "astro check",
    "lint": "eslint .",
    "pretest": "npm run gen",
    "test": "node --test \"test/**/*.test.ts\"",
    "verify": "npm run check && npm run lint && npm test && npm run build",
    "fonts": "node scripts/fonts.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vscode/codicons": "^0.0.46-24",
    "astro": "^7.3.2",
    "gsap": "^3.15.0",
    "subset-font": "^2.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vscode-languageserver-textdocument": "^1.0.13",
    "vscode-languageserver-types": "^3.18.0"
  }
}
