---
import Base from '../layouts/Base.astro';
import Footer from '../components/sections/Footer.astro';
import GettingStarted from '../components/sections/GettingStarted.astro';
import Hero from '../components/sections/Hero.astro';
import Notation from '../components/sections/Notation.astro';
import Stage from '../components/stage/Stage.astro';
import Stances from '../components/sections/Stances.astro';
import Submission from '../components/sections/Submission.astro';
import Typesetting from '../components/sections/Typesetting.astro';
---

<Base title="Japanese Novel — 書いて、確かめて、一冊にする。すべて縦書きのまま。" description="VS Code を小説の執筆環境に変える拡張機能。書いた文章はすぐ隣に縦書きで表示され、章をまとめて HTML・EPUB・テキストの本として出力できます。記法は青空文庫の注記そのまま。">
  <Hero />
  <main>
    <Stage />
    <Notation />
    <Submission />
    <Typesetting />
    <Stances />
    <GettingStarted />
  </main>
  <Footer />
</Base>

<script>
  import { mountReveal } from '../scripts/reveal.ts';

  mountReveal();
</script>
