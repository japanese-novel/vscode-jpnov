---
import { LINKS } from '../copy/links.ts';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<button type="button" class="jp-cta" popovertarget={id}>今すぐ入手する</button>
<ul id={id} class="jp-get-menu" popover>
  <li><a href={LINKS.marketplace} target="_blank" rel="noopener">VS Code Marketplace</a></li>
  <li><a href={LINKS.openvsx} target="_blank" rel="noopener">Open VSX</a></li>
</ul>
