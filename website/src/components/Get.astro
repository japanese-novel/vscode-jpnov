---
import { LINKS } from '../copy/links.ts';
import Menu from './Menu.astro';

interface Props {
  id: string;
}

const { id } = Astro.props;
const STORES = [
  { label: 'Visual Studio Marketplace', href: LINKS.marketplace },
  { label: 'Open VSX', href: LINKS.openvsx },
] as const;
---

<Menu id={id} label="今すぐ入手する" items={STORES} />
