---
import book from '../../../../resources/book.svg?raw';
import Icon from './Icon.astro';

/** The product's own view icon, inlined like the codicons: the XML comment goes, the class sizes it. */
const SVG_TAG = '<svg ';
if (!book.includes(SVG_TAG)) {
  throw new Error(`ActivityBar: resources/book.svg has no "${SVG_TAG}" to class`);
}
const BOOK = book.replace(/<!--[\s\S]*?-->\s*/, '').replace(SVG_TAG, `${SVG_TAG}class="jp-cd" aria-hidden="true" `);
---

<div class="jp-activity">
  <span class="jp-act"><Icon name="files" /></span>
  <span class="jp-act"><Icon name="search" /></span>
  <span class="jp-act"><Icon name="source-control" /></span>
  <span class="jp-act"><Icon name="debug-alt" /></span>
  <span class="jp-act"><Icon name="extensions" /></span>
  <span class="jp-act jp-on" set:html={BOOK}></span>
  <span class="jp-act jp-bottom"><Icon name="account" /></span>
  <span class="jp-act"><Icon name="settings-gear" /></span>
</div>
