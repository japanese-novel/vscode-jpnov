---
import Icon from './Icon.astro';
---

<div class="jp-activity">
  <span class="jp-act"><Icon name="files" /></span>
  <span class="jp-act"><Icon name="search" /></span>
  <span class="jp-act"><Icon name="source-control" /></span>
  <span class="jp-act"><Icon name="debug-alt" /></span>
  <span class="jp-act"><Icon name="extensions" /></span>
  <span class="jp-act jp-on"><svg class="jp-cd jp-book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><g stroke-width="2"><path d="M18 6.5v14"></path><path d="M12 9.5v11"></path><path d="M6 6.5v9"></path></g><path d="M9.5 4h5v3" stroke-width="1.5"></path><rect x="4.6" y="18" width="3" height="3" rx="0.6" fill="currentColor" stroke="none"></rect></svg></span>
  <span class="jp-act jp-bottom"><Icon name="account" /></span>
  <span class="jp-act"><Icon name="settings-gear" /></span>
