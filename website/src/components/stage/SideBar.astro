---
/** The Books view in detail mode, mirroring src/client/webview/book/main.ts's DOM. */
import type { CountsVM } from '../../../../src/client/protocol.ts';
import { GLYPH } from '../../../../src/client/webview/book/glyphs.ts';
import { NAMES, PRODUCT, UI } from '../../stage/strings.ts';
import Icon from './Icon.astro';

interface Props {
  /** Chapter rows in display order. */
  chapters: readonly string[];
  /** The status row under the lists: the body's figures, as the product prints them. */
  counts: CountsVM;
  /** Motion: a row appended later (hidden until the collect beat) and the figures once it has joined, keyed for the timeline. */
  pending?: { readonly name: string; readonly counts: CountsVM } | undefined;
}

const { chapters, counts, pending } = Astro.props;
const rows = pending === undefined ? chapters : [...chapters, pending.name];
const figures = pending === undefined ? [counts] : [counts, pending.counts];
---

<div class="jp-sidebar">
  <div class="jp-vhead"><span>{PRODUCT.viewTitle(NAMES.bookTitle)}</span><span class="jp-vacts"><Icon name="lightbulb-autofix" /><Icon name="refresh" /></span></div>
  <div class="jp-scroll">
    <div class="jp-dhdr"><span class="jp-iconbtn"><Icon name="chevron-left" /></span><div class="jp-dtitle">{NAMES.bookTitle}</div></div>
    {/* The product's detail view: the info section, then its FOLDING lists (src/client/webview/book/main.ts,
        not exported), each collapsed, then the chapters below. */}
    {[UI.bookInfo, UI.characters, UI.keywords, UI.covers].map((title) => (
      <div class="jp-section">
        <div class="jp-shead"><span class="jp-sectoggle"><Icon name="chevron-right" class="jp-caret" /><span class="jp-stitle">{title}</span></span></div>
      </div>
    ))}
    <div class="jp-section jp-toc" data-t="toc">
      <div class="jp-shead"><span class="jp-stitle">{UI.chapters}</span></div>
      {rows.map((name, i) => (
        <div class:list={['jp-row', { 'jp-st-none': name === pending?.name }]} data-t={`row-${String(i + 1)}`}>
          <Icon name="gripper" class="jp-grip" />
          <span class="jp-emain"><span class="jp-title">{name}</span></span>
          <span class="jp-acts">
            <span class:list={['jp-iconbtn', { 'jp-dis': i === 0 }]}><Icon name="chevron-up" /></span>
            <span class:list={['jp-iconbtn', { 'jp-dis': i === chapters.length - 1 && name !== pending?.name }]}><Icon name="chevron-down" /></span>
            <span class="jp-iconbtn"><Icon name="close" /></span>
          </span>
        </div>
      ))}
      <div class="jp-row jp-action"><Icon name="new-file" /><span>{UI.addChapters}</span></div>
    </div>
  </div>
  <div class="jp-footer">
    {figures.map((f, i) => (
      <div class:list={['jp-counts', { 'jp-st-none': f === pending?.counts }]} data-t={`counts-${String(i + 1)}`}>{[f.pages, f.sheets, f.chars].map((item) => <span title={item.title}>{item.text}</span>)}</div>
    ))}
    <span class="jp-btn jp-primary" data-t="btn-print"><svg viewBox={GLYPH.print.viewBox} fill="currentColor" aria-hidden="true">{GLYPH.print.d.map((d) => <path d={d}></path>)}</svg>{UI.print}</span>
    <div class="jp-btnrow"><span class="jp-btn">{UI.txt}</span><span class="jp-btn jp-icon" title={UI.epub}><svg viewBox={GLYPH.epub.viewBox} fill="currentColor" aria-hidden="true">{GLYPH.epub.d.map((d) => <path d={d}></path>)}</svg></span></div>
    <span class="jp-chkrow"><i class="jp-chk"><Icon name="check" /></i>{UI.openAfterBuild}</span>
  </div>
</div>
