---
import { NAMES, UI, VSCODE } from '../../stage/strings.ts';
import Icon from './Icon.astro';
---

<div class="jp-qi jp-st-hide" data-t="qp">
  <div class="jp-qi-in"><span class="jp-ph">{UI.pickChapters}</span><span class="jp-qi-ok" data-t="qp-ok">{VSCODE.pickOk}</span></div>
  <div class="jp-qi-item" data-t="qp-item"><span class="jp-qi-cb" data-t="qp-cb"><Icon name="check" /></span>{NAMES.chapter2}</div>
</div>
