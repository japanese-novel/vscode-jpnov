---
/** The built book as the browser shows it: the first body page with the artifact's own print button. */
import { sampleOf } from '../../renders.ts';

const book = sampleOf('stageBook', 'book');
// The em as a share of the paper's width and height; stage.css sizes the sheet from them.
const { widthMm, heightMm, fontMm } = book.paper;
---

<div class={`jp-page jp-scope ${book.fragment.scope.slice(1)}`} style={`--fw:${String(fontMm / widthMm)};--fh:${String(fontMm / heightMm)}`} set:html={book.fragment.body}></div>
