{
  "name": "jpnov",
  "displayName": "Japanese Novel",
  "publisher": "asagirimihatsu",
  "version": "0.9.0",
  "description": "VS Code を小説の執筆環境に変える拡張機能。書いた文章はすぐ隣に縦書きで表示され、章をまとめて HTML・EPUB・テキストの本として出力できます。出力した HTML はブラウザーでそのまま印刷・PDF 保存できます。記法は青空文庫の注記そのまま。",
  "icon": "resources/icon.png",
  "keywords": [
    "小説",
    "縦書き",
    "青空文庫",
    "novel",
    "japanese",
    "aozora",
    "vertical writing"
  ],
  "homepage": "https://jpnov.com",
  "bugs": {
    "url": "https://github.com/japanese-novel/vscode-jpnov/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/japanese-novel/vscode-jpnov.git"
  },
  "license": "MIT",
  "author": "Mihatsu Asagiri",
  "type": "module",
  "main": "dist/client/extension.js",
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.131.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onWebviewPanel:jpnov.preview",
    "onStartupFinished"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jpnov",
        "aliases": [
          "%language.jpnov.alias%"
        ],
        "extensions": [
          ".jpnov"
        ],
        "configuration": "./jpnov.language-configuration.json"
      },
      {
        "id": "jpbook",
        "aliases": [
          "%language.jpbook.alias%"
        ],
        "extensions": [
          ".jpbook"
        ],
        "configuration": "./jpbook.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jpnov",
        "scopeName": "text.jpnov",
        "path": "./syntaxes/jpnov.tmLanguage.json"
      },
      {
        "language": "jpbook",
        "scopeName": "text.jpbook",
        "path": "./syntaxes/jpbook.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[jpnov]": {
        "editor.copyWithSyntaxHighlighting": false,
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true,
        "editor.unicodeHighlight.nonBasicASCII": false,
        "editor.unicodeHighlight.allowedCharacters": {
          "　": true,
          "！": true,
          "？": true,
          "（": true,
          "）": true,
          "：": true,
          "；": true,
          "，": true,
          "．": true,
          "｜": true,
          "＃": true,
          "［": true,
          "］": true,
          "〔": true,
          "〕": true,
          "〜": true,
          "～": true,
          "＊": true
        }
      },
      "[jpbook]": {
        "editor.copyWithSyntaxHighlighting": false,
        "editor.wordBasedSuggestions": "off",
        "editor.unicodeHighlight.nonBasicASCII": false,
        "editor.unicodeHighlight.allowedCharacters": {
          "　": true,
          "！": true,
          "？": true,
          "（": true,
          "）": true,
          "：": true,
          "；": true,
          "，": true,
          "．": true,
          "｜": true,
          "＃": true,
          "［": true,
          "］": true,
          "〔": true,
          "〕": true,
          "〜": true,
          "～": true,
          "＊": true
        }
      },
      "github.copilot.enable": {
        "jpnov": false,
        "jpbook": false
      }
    },
    "configuration": [
      {
        "title": "%jpnov.layout.title%",
        "order": 1,
        "properties": {
          "jpnov.layout.charsPerLine": {
            "type": "integer",
            "default": 40,
            "minimum": 16,
            "maximum": 64,
            "order": 1,
            "markdownDescription": "%jpnov.layout.charsPerLine.description%"
          },
          "jpnov.layout.linesPerPage": {
            "type": "integer",
            "default": 34,
            "minimum": 16,
            "maximum": 64,
            "order": 2,
            "markdownDescription": "%jpnov.layout.linesPerPage.description%"
          },
          "jpnov.layout.linePitch": {
            "type": "number",
            "enum": [
              1.5,
              1.75,
              2,
              2.25
            ],
            "default": 1.5,
            "enumItemLabels": [
              "%jpnov.layout.linePitch.1.5.label%",
              "%jpnov.layout.linePitch.1.75.label%",
              "%jpnov.layout.linePitch.2.label%",
              "%jpnov.layout.linePitch.2.25.label%"
            ],
            "enumDescriptions": [
              "%jpnov.layout.linePitch.1.5.description%",
              "%jpnov.layout.linePitch.1.75.description%",
              "%jpnov.layout.linePitch.2.description%",
              "%jpnov.layout.linePitch.2.25.description%"
            ],
            "order": 3,
            "markdownDescription": "%jpnov.layout.linePitch.description%"
          },
          "jpnov.layout.fontFamily": {
            "type": "string",
            "default": "",
            "order": 4,
            "markdownDescription": "%jpnov.layout.fontFamily.description%"
          },
          "jpnov.layout.kinsoku": {
            "type": "string",
            "enum": [
              "none",
              "relaxed",
              "strict"
            ],
            "default": "strict",
            "enumItemLabels": [
              "%jpnov.layout.kinsoku.none.label%",
              "%jpnov.layout.kinsoku.relaxed.label%",
              "%jpnov.layout.kinsoku.strict.label%"
            ],
            "enumDescriptions": [
              "%jpnov.layout.kinsoku.none.description%",
              "%jpnov.layout.kinsoku.relaxed.description%",
              "%jpnov.layout.kinsoku.strict.description%"
            ],
            "order": 5,
            "markdownDescription": "%jpnov.layout.kinsoku.description%"
          },
          "jpnov.layout.autoTcy": {
            "type": "string",
            "enum": [
              "none",
              "punctuationPairs"
            ],
            "default": "punctuationPairs",
            "enumItemLabels": [
              "%jpnov.layout.autoTcy.none.label%",
              "%jpnov.layout.autoTcy.punctuationPairs.label%"
            ],
            "enumDescriptions": [
              "%jpnov.layout.autoTcy.none.description%",
              "%jpnov.layout.autoTcy.punctuationPairs.description%"
            ],
            "order": 6,
            "markdownDescription": "%jpnov.layout.autoTcy.description%"
          },
          "jpnov.layout.preview.lineNumbers": {
            "type": "boolean",
            "default": true,
            "order": 7,
            "markdownDescription": "%jpnov.layout.preview.lineNumbers.description%"
          },
          "jpnov.layout.preview.edgeLine": {
            "type": "string",
            "enum": [
              "none",
              "text",
              "red"
            ],
            "default": "none",
            "enumItemLabels": [
              "%jpnov.layout.preview.edgeLine.none.label%",
              "%jpnov.layout.preview.edgeLine.text.label%",
              "%jpnov.layout.preview.edgeLine.red.label%"
            ],
            "enumDescriptions": [
              "%jpnov.layout.preview.edgeLine.none.description%",
              "%jpnov.layout.preview.edgeLine.text.description%",
              "%jpnov.layout.preview.edgeLine.red.description%"
            ],
            "order": 8,
            "markdownDescription": "%jpnov.layout.preview.edgeLine.description%"
          },
          "jpnov.layout.paper.size": {
            "type": "string",
            "enum": [
              "a4",
              "a6"
            ],
            "default": "a4",
            "enumItemLabels": [
              "%jpnov.layout.paper.size.a4.label%",
              "%jpnov.layout.paper.size.a6.label%"
            ],
            "enumDescriptions": [
              "%jpnov.layout.paper.size.a4.description%",
              "%jpnov.layout.paper.size.a6.description%"
            ],
            "order": 9,
            "markdownDescription": "%jpnov.layout.paper.size.description%"
          },
          "jpnov.layout.paper.orientation": {
            "type": "string",
            "enum": [
              "auto",
              "landscape",
              "portrait"
            ],
            "default": "auto",
            "enumItemLabels": [
              "%jpnov.layout.paper.orientation.auto.label%",
              "%jpnov.layout.paper.orientation.landscape.label%",
              "%jpnov.layout.paper.orientation.portrait.label%"
            ],
            "enumDescriptions": [
              "%jpnov.layout.paper.orientation.auto.description%",
              "%jpnov.layout.paper.orientation.landscape.description%",
              "%jpnov.layout.paper.orientation.portrait.description%"
            ],
            "order": 10,
            "markdownDescription": "%jpnov.layout.paper.orientation.description%"
          },
          "jpnov.layout.paper.lineNumbers": {
            "type": "boolean",
            "default": false,
            "order": 11,
            "markdownDescription": "%jpnov.layout.paper.lineNumbers.description%"
          },
          "jpnov.layout.paper.edgeLine": {
            "type": "string",
            "enum": [
              "none",
              "text",
              "red"
            ],
            "default": "none",
            "enumItemLabels": [
              "%jpnov.layout.paper.edgeLine.none.label%",
              "%jpnov.layout.paper.edgeLine.text.label%",
              "%jpnov.layout.paper.edgeLine.red.label%"
            ],
            "enumDescriptions": [
              "%jpnov.layout.paper.edgeLine.none.description%",
              "%jpnov.layout.paper.edgeLine.text.description%",
              "%jpnov.layout.paper.edgeLine.red.description%"
            ],
            "order": 12,
            "markdownDescription": "%jpnov.layout.paper.edgeLine.description%"
          },
          "jpnov.layout.txt.encoding": {
            "type": "string",
            "enum": [
              "shiftJis",
              "utf8",
              "utf8Bom"
            ],
            "default": "shiftJis",
            "enumItemLabels": [
              "%jpnov.layout.txt.encoding.shiftJis.label%",
              "%jpnov.layout.txt.encoding.utf8.label%",
              "%jpnov.layout.txt.encoding.utf8Bom.label%"
            ],
            "enumDescriptions": [
              "%jpnov.layout.txt.encoding.shiftJis.description%",
              "%jpnov.layout.txt.encoding.utf8.description%",
              "%jpnov.layout.txt.encoding.utf8Bom.description%"
            ],
            "order": 13,
            "markdownDescription": "%jpnov.layout.txt.encoding.description%"
          },
          "jpnov.layout.outDir": {
            "type": "string",
            "default": "dist",
            "scope": "resource",
            "order": 14,
            "markdownDescription": "%jpnov.layout.outDir.description%"
          }
        }
      },
      {
        "title": "%jpnov.lint.title%",
        "order": 2,
        "properties": {
          "jpnov.lint.common.sentenceLength": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "minimum": 1,
            "maximum": 1000,
            "order": 1,
            "markdownDescription": "%jpnov.lint.common.sentenceLength.description%"
          },
          "jpnov.lint.common.maxTen": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "minimum": 1,
            "maximum": 20,
            "order": 2,
            "markdownDescription": "%jpnov.lint.common.maxTen.description%"
          },
          "jpnov.lint.common.maxKanjiRun": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "minimum": 1,
            "maximum": 20,
            "order": 3,
            "markdownDescription": "%jpnov.lint.common.maxKanjiRun.description%"
          },
          "jpnov.lint.common.dash": {
            "type": "string",
            "enum": [
              "emDash",
              "horizontalBar",
              "boxDrawing"
            ],
            "default": "horizontalBar",
            "enumItemLabels": [
              "%jpnov.lint.common.dash.emDash.label%",
              "%jpnov.lint.common.dash.horizontalBar.label%",
              "%jpnov.lint.common.dash.boxDrawing.label%"
            ],
            "enumDescriptions": [
              "%jpnov.lint.common.dash.emDash.description%",
              "%jpnov.lint.common.dash.horizontalBar.description%",
              "%jpnov.lint.common.dash.boxDrawing.description%"
            ],
            "order": 4,
            "markdownDescription": "%jpnov.lint.common.dash.description%"
          },
          "jpnov.lint.common.ellipsis": {
            "type": "boolean",
            "default": true,
            "order": 5,
            "markdownDescription": "%jpnov.lint.common.ellipsis.description%"
          },
          "jpnov.lint.common.exclamationSpace": {
            "type": "boolean",
            "default": true,
            "order": 6,
            "markdownDescription": "%jpnov.lint.common.exclamationSpace.description%"
          },
          "jpnov.lint.common.exclamationRun": {
            "type": "boolean",
            "default": false,
            "order": 7,
            "markdownDescription": "%jpnov.lint.common.exclamationRun.description%"
          },
          "jpnov.lint.common.arabicDigits": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "minimum": 1,
            "maximum": 10,
            "order": 8,
            "markdownDescription": "%jpnov.lint.common.arabicDigits.description%"
          },
          "jpnov.lint.common.noTrailingSpace": {
            "type": "boolean",
            "default": true,
            "order": 9,
            "markdownDescription": "%jpnov.lint.common.noTrailingSpace.description%"
          },
          "jpnov.lint.common.blankRun": {
            "type": [
              "integer",
              "null"
            ],
            "default": null,
            "minimum": 0,
            "maximum": 20,
            "order": 10,
            "markdownDescription": "%jpnov.lint.common.blankRun.description%"
          },
          "jpnov.lint.common.noUnmatchedPair": {
            "type": "boolean",
            "default": true,
            "order": 11,
            "markdownDescription": "%jpnov.lint.common.noUnmatchedPair.description%"
          },
          "jpnov.lint.common.noHankakuKana": {
            "type": "boolean",
            "default": true,
            "order": 12,
            "markdownDescription": "%jpnov.lint.common.noHankakuKana.description%"
          },
          "jpnov.lint.common.noNfd": {
            "type": "boolean",
            "default": true,
            "order": 13,
            "markdownDescription": "%jpnov.lint.common.noNfd.description%"
          },
          "jpnov.lint.common.noZeroWidth": {
            "type": "boolean",
            "default": true,
            "order": 14,
            "markdownDescription": "%jpnov.lint.common.noZeroWidth.description%"
          },
          "jpnov.lint.common.noControlChar": {
            "type": "boolean",
            "default": true,
            "order": 15,
            "markdownDescription": "%jpnov.lint.common.noControlChar.description%"
          },
          "jpnov.lint.common.shiftJisSafe": {
            "type": "boolean",
            "default": true,
            "order": 16,
            "markdownDescription": "%jpnov.lint.common.shiftJisSafe.description%"
          },
          "jpnov.lint.common.jaNoSpaceBetweenFullWidth": {
            "type": "boolean",
            "default": false,
            "order": 17,
            "markdownDescription": "%jpnov.lint.common.jaNoSpaceBetweenFullWidth.description%"
          },
          "jpnov.lint.common.jaUnnaturalAlphabet": {
            "type": "boolean",
            "default": false,
            "order": 18,
            "markdownDescription": "%jpnov.lint.common.jaUnnaturalAlphabet.description%"
          },
          "jpnov.lint.common.minusPosition": {
            "type": "boolean",
            "default": false,
            "order": 19,
            "markdownDescription": "%jpnov.lint.common.minusPosition.description%"
          },
          "jpnov.lint.narration.indent": {
            "type": "boolean",
            "default": true,
            "order": 20,
            "markdownDescription": "%jpnov.lint.narration.indent.description%"
          },
          "jpnov.lint.narration.endPeriod": {
            "type": "boolean",
            "default": true,
            "order": 21,
            "markdownDescription": "%jpnov.lint.narration.endPeriod.description%"
          },
          "jpnov.lint.dialogue.closingPunct": {
            "type": "boolean",
            "default": true,
            "order": 22,
            "markdownDescription": "%jpnov.lint.dialogue.closingPunct.description%"
          },
          "jpnov.lint.dialogue.noIndent": {
            "type": "boolean",
            "default": true,
            "order": 23,
            "markdownDescription": "%jpnov.lint.dialogue.noIndent.description%"
          },
          "jpnov.lint.ruby.kana": {
            "type": "string",
            "enum": [
              "off",
              "hiragana",
              "katakana"
            ],
            "default": "off",
            "enumItemLabels": [
              "%jpnov.lint.ruby.kana.off.label%",
              "%jpnov.lint.ruby.kana.hiragana.label%",
              "%jpnov.lint.ruby.kana.katakana.label%"
            ],
            "enumDescriptions": [
              "%jpnov.lint.ruby.kana.off.description%",
              "%jpnov.lint.ruby.kana.hiragana.description%",
              "%jpnov.lint.ruby.kana.katakana.description%"
            ],
            "order": 24,
            "markdownDescription": "%jpnov.lint.ruby.kana.description%"
          }
        }
      },
      {
        "title": "%jpnov.editor.title%",
        "order": 3,
        "properties": {
          "jpnov.editor.autoIndent": {
            "type": "boolean",
            "default": true,
            "order": 1,
            "markdownDescription": "%jpnov.editor.autoIndent.description%"
          },
          "jpnov.editor.highlight.characters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "order": 2,
            "markdownDescription": "%jpnov.editor.highlight.characters.description%"
          },
          "jpnov.editor.highlight.keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "order": 3,
            "markdownDescription": "%jpnov.editor.highlight.keywords.description%"
          },
          "jpnov.editor.updateRefsOnFileMove": {
            "type": "string",
            "enum": [
              "prompt",
              "always",
              "never"
            ],
            "default": "prompt",
            "enumItemLabels": [
              "%jpnov.editor.updateRefsOnFileMove.prompt.label%",
              "%jpnov.editor.updateRefsOnFileMove.always.label%",
              "%jpnov.editor.updateRefsOnFileMove.never.label%"
            ],
            "enumDescriptions": [
              "%jpnov.editor.updateRefsOnFileMove.prompt.description%",
              "%jpnov.editor.updateRefsOnFileMove.always.description%",
              "%jpnov.editor.updateRefsOnFileMove.never.description%"
            ],
            "order": 4,
            "markdownDescription": "%jpnov.editor.updateRefsOnFileMove.description%"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "jpbook.refresh",
        "category": "%command.category%",
        "title": "%command.books.refresh.title%",
        "icon": "$(refresh)"
      },
      {
        "command": "jpbook.createFile",
        "category": "%command.category%",
        "title": "%command.books.createFile.title%",
        "icon": "$(add)"
      },
      {
        "command": "jpnov.openGuide",
        "category": "%command.category%",
        "title": "%command.openGuide.title%"
      },
      {
        "command": "jpnov.preview",
        "category": "%command.category%",
        "title": "%command.preview.title%"
      },
      {
        "command": "jpnov.previewToSide",
        "category": "%command.category%",
        "title": "%command.previewToSide.title%",
        "icon": "$(open-preview)"
      }
    ],
    "views": {
      "jpnov": [
        {
          "id": "jpnov.books",
          "type": "webview",
          "name": "%view.books.name%",
          "icon": "$(book)",
          "when": "jpnov.active",
          "contextualTitle": "%view.books.contextualTitle%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "jpbook.createFile",
          "group": "navigation@0",
          "when": "view == jpnov.books && !jpnov.booksDetail && workspaceFolderCount != 0"
        },
        {
          "command": "jpbook.refresh",
          "group": "navigation@1",
          "when": "view == jpnov.books"
        }
      ],
      "editor/title": [
        {
          "command": "jpnov.previewToSide",
          "group": "navigation",
          "when": "editorLangId == jpnov"
        }
      ],
      "commandPalette": [
        {
          "command": "jpnov.preview",
          "when": "editorLangId == jpnov"
        },
        {
          "command": "jpnov.previewToSide",
          "when": "editorLangId == jpnov"
        },
        {
          "command": "jpbook.refresh",
          "when": "false"
        },
        {
          "command": "jpbook.createFile",
          "when": "workspaceFolderCount != 0"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "jpnov",
          "title": "%view.container.title%",
          "icon": "resources/book.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "jpnov.gettingStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "featuredFor": [
          "**/*.jpnov",
          "**/*.jpbook"
        ],
        "steps": [
          {
            "id": "chapter",
            "title": "%walkthrough.chapter.title%",
            "description": "%walkthrough.chapter.description%",
            "media": {
              "markdown": "media/walkthrough/chapter.md"
            },
            "completionEvents": [
              "onCommand:workbench.action.files.newUntitledFile"
            ]
          },
          {
            "id": "preview",
            "title": "%walkthrough.preview.title%",
            "description": "%walkthrough.preview.description%",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:jpnov.previewToSide"
            ]
          },
          {
            "id": "build",
            "title": "%walkthrough.build.title%",
            "description": "%walkthrough.build.description%",
            "media": {
              "markdown": "media/walkthrough/build.md"
            },
            "completionEvents": [
              "onContext:jpnov.hasBuilt"
            ]
          },
          {
            "id": "highlight",
            "title": "%walkthrough.highlight.title%",
            "description": "%walkthrough.highlight.description%",
            "media": {
              "markdown": "media/walkthrough/highlight.md"
            },
            "completionEvents": [
              "onSettingChanged:jpnov.editor.highlight.characters",
              "onSettingChanged:jpnov.editor.highlight.keywords",
              "onSettingChanged:jpnov.lint.narration.indent"
            ]
          }
        ]
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "type-check": "tsc --noEmit && tsc -p src/client/webview/tsconfig.json --noEmit",
    "lint": "eslint .",
    "gen": "npm run gen:styles && npm run gen:webview",
    "gen:styles": "node scripts/gen-styles.ts",
    "gen:webview": "node scripts/gen-webview.ts",
    "prepare": "npm run gen",
    "build": "node esbuild.config.js --production",
    "build:dev": "node esbuild.config.js",
    "watch:esbuild": "node esbuild.config.js --watch",
    "watch:tsc": "tsc --noEmit --watch",
    "watch:tsc:webview": "tsc -p src/client/webview/tsconfig.json --noEmit --watch",
